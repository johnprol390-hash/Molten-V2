# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string. Use Vercel Postgres, Neon, Supabase, etc.
# Vercel Postgres exposes POSTGRES_PRISMA_URL — copy it into DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:5432/molten?sslmode=require"

# ── Realtime (optional) ──────────────────────────────────────────────────────
# Public URL the browser uses to reach the standalone WebSocket server.
# Leave unset on Vercel (serverless can't host a long-lived ws server); the
# client automatically falls back to a simulated in-browser feed.
NEXT_PUBLIC_WS_URL=""
# Port the standalone ws server listens on when self-hosting `pnpm ws`.
WS_PORT="4001"

# ── Session (optional) ───────────────────────────────────────────────────────
# Secret used to sign the session cookie. Set a long random value in production.
SESSION_SECRET="change-me-to-a-long-random-string"
